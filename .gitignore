# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.venv/
__pycache__/
*.pyc
*.pyo

# ── Build Outputs ─────────────────────────────────────────────────────────
backend/dist/
frontend/.next/
frontend/out/
dist-electron/
dump.rdb

# ── Environment Variables (NEVER commit secrets) ──────────────────────────
.env
.env.local
.env.*.local
# Keep the example safe to commit
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid

# ── OS & Editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── TypeScript build info ─────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Uploaded files (runtime data) ────────────────────────────────────────
backend/uploads/
*.rdb

# ── AI model weights (large binary files — store in Git LFS or separately)
ai model/models/*.pth
ai model/models/*.pt
ai model/models/*.h5

# ── Prisma generated client ───────────────────────────────────────────────
backend/node_modules/.prisma/

# ── Redis Windows binary (large, downloadable) ────────────────────────────
electron/assets/redis/

# ── Electron build cache ──────────────────────────────────────────────────
electron-builder-cache/
