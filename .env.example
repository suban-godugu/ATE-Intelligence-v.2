# ==========================================
# ATE Intelligence Cost Optimization Platform
# Environment Variables Configuration
# ==========================================

# ── Database Configurations (PostgreSQL) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ate_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ate_db?schema=public

# ── Queue / Cache Configurations (Redis) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── NestJS Backend Configurations ──
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Next.js Frontend Configurations ──
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_HOST=localhost
