# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=compty_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=compty_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=10&pool_timeout=30"

# Cache & Message Queue Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Object Storage Configuration (MinIO)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=compty_admin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET_WAFER=wafer-images
MINIO_PRESIGNED_URL_EXPIRY=3600
WAFER_IMAGE_THRESHOLD_BYTES=5242880
